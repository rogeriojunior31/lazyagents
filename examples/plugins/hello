#!/bin/sh
# Example lazyagents plugin: a tab that echoes the last key.
# Install with: cp examples/plugins/hello ~/.config/lazyagents/plugins/hello
#
# Modes: `hello serve` (TUI tab), `hello doctor` (check); any other argument is
# the pass-through of `lazyagents hello …`.

case "$1" in
serve) ;;
doctor) echo "hello: all good"; exit 0 ;;
*) echo "hello: args=$* data=$LAZYAGENTS_DATA_DIR"; exit 0 ;;
esac

read init # {"type":"init",...}: size, paths, theme and the hello: section of config.yaml
printf '{"type":"manifest","title":"Hello","doctor":true,"help":[{"title":"Hello","keys":[["any","echo the key"],["e","open $EDITOR (interactive exec)"]]}],"commands":[{"name":"reset","desc":"clear the echo"}]}\n'
# JSON requires escaped control characters: ESC is \u001b (SGR bold/colors are allowed).
frame() { printf '{"type":"frame","view":"\\u001b[1mHello, lazyagents!\\u001b[0m\\n\\n%s","count":%d}\n' "$1" "$2"; }
n=0
frame "Press a key." 0
while read line; do
  case "$line" in
  *'"type":"key"'*)
    k=$(printf '%s' "$line" | sed 's/.*"key":"\([^"]*\)".*/\1/')
    n=$((n + 1))
    if [ "$k" = "e" ]; then
      printf '{"type":"exec","execId":%d,"argv":["%s","/dev/null"],"interactive":true}\n' "$n" "${EDITOR:-vi}"
    fi
    frame "Last key: $k" "$n" ;;
  *'"type":"exec_result"'*) frame "Editor closed." "$n" ;;
  *'"type":"command"'*) n=0; frame "Press a key." 0 ;;
  *'"type":"reload"'*) frame "Reloaded." "$n" ;;
  esac
done
